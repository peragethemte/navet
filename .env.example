NAVET_HOMEY_CLIENT_ID=
NAVET_HOMEY_CLIENT_SECRET=
# Optional override. Navet derives the callback URL from the current origin by default.
NAVET_HOMEY_REDIRECT_URI=
# Optional dashboard YAML export to auto-import for fresh browsers.
NAVET_DASHBOARD_CONFIG_URL=
# Yr.no / met.no weather. Latitude and longitude enable the Yr.no weather provider
# (no login required - it connects automatically once both are set). Example: Sarpsborg,
# Ostfold, Norway.
NAVET_YR_LATITUDE=59.3
NAVET_YR_LONGITUDE=11.1
# Optional display label shown on the weather card.
NAVET_YR_LOCATION_NAME=Sarpsborg
