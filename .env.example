NAVET_HOMEY_CLIENT_ID=
NAVET_HOMEY_CLIENT_SECRET=
# Optional override. Navet derives the callback URL from the current origin by default.
NAVET_HOMEY_REDIRECT_URI=
# Optional dashboard YAML export to auto-import for fresh browsers.
NAVET_DASHBOARD_CONFIG_URL=
# Yr.no / met.no weather. Optional fallback location, used until someone sets one under
# Settings > Local services. Latitude and longitude together enable the Yr.no weather provider
# (no login required - it connects automatically). Example: Sarpsborg, Ostfold, Norway.
NAVET_YR_LATITUDE=59.3
NAVET_YR_LONGITUDE=11.1
# Optional display label shown on the weather card while the fallback location is in use.
NAVET_YR_LOCATION_NAME=Sarpsborg
# Apple iCloud calendars, read over CalDAV. Both values together enable the iCloud Calendar
# provider (no login required - it connects automatically). The password must be an
# app-specific password from appleid.apple.com, not the Apple ID's own password. Leave empty
# to run without calendars. Both accept a _FILE twin pointing at a mounted secret instead.
NAVET_ICLOUD_APPLE_ID=
NAVET_ICLOUD_APP_PASSWORD=
# Optional. How often iCloud is polled, how far ahead events are fetched, how much history is
# kept so an event already under way still shows, and the cap per calendar.
NAVET_ICLOUD_CALENDAR_POLL_SECONDS=300
NAVET_ICLOUD_CALENDAR_DAYS=31
NAVET_ICLOUD_CALENDAR_PAST_DAYS=1
NAVET_ICLOUD_MAX_EVENTS_PER_CALENDAR=25
